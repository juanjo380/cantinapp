APP_NAME=CantinAPP API
ENVIRONMENT=development

DB_HOST=tu-host-de-supabase
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=tu-password-de-supabase

DB_SSL=true
DB_USE_TRANSACTION_POOLER=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_ECHO=false

JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRE_MINUTES=720
CORS_ORIGINS=["http://localhost:5173"]

# Correo (recuperar contraseña e invitaciones al equipo).
# console: no envía nada, escribe el correo en el log (en development con el código).
# brevo: API HTTPS de Brevo (gratis 300/día). Render en plan gratis bloquea SMTP, por eso no se usa SMTP.
MAIL_BACKEND=console
BREVO_API_KEY=
MAIL_FROM=soportecantinapp@gmail.com
MAIL_FROM_NAME=CantinAPP
# Base de los enlaces de los correos (el frontend en Vercel en producción)
FRONTEND_URL=http://localhost:5173

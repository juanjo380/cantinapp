# ============================================================
# CantinAPP — lo que NO se versiona (nada de esto hace falta
# para ejecutar el código; se regenera o es local de tu máquina)
# ============================================================

# --- Dependencias ---
node_modules/
venv/
.venv/
env/
ENV/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/
.mypy_cache/

# --- Builds / artefactos (se regeneran con npm run build) ---
build/
dist/
dist-ssr/

# --- Variables de entorno (se conservan las plantillas .example) ---
.env
.env.*
!.env.example

# --- Herramientas locales del agente (no hacen falta para ejecutar la app) ---
.opencode/
.claude/
# Grafo de graphify: caché AST, graph.json, cost.json, etc. Se regenera con /graphify.
graphify-out/

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Editores / IDE ---
.idea/
.vscode/
*.swp
*.swo
*.suo
*.njsproj
*.sln

# --- Sistema operativo ---
.DS_Store
Thumbs.db
